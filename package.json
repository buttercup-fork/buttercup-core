{
  "name": "buttercup",
  "version": "7.7.1",
  "description": "A NodeJS password vault.",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./dist/web/index.js",
      "default": "./dist/node/index.js"
    },
    "./web": "./dist/web/index.js"
  },
  "react-native": "./dist/web/index.js",
  "types": "dist/node/index.d.ts",
  "contributors": [
    {
      "name": "Perry Mitchell",
      "email": "perry@perrymitchell.net"
    }
  ],
  "scripts": {
    "analyse": "ANALYSE=bundle npm run build",
    "build": "run-s clean build:node build:web",
    "build:node": "tsc && npm run build:node:rename",
    "build:node:rename": "mv ./dist/node/index.node.js ./dist/node/index.js && mv ./dist/node/index.node.d.ts ./dist/node/index.d.ts",
    "build:web": "run-s build:web:source build:web:types",
    "build:web:source": "webpack --config webpack.config.cjs --mode=production",
    "build:web:types": "tsc --emitDeclarationOnly --outDir ./dist/web && mv ./dist/web/index.web.d.ts ./dist/web/index.d.ts",
    "clean": "rimraf ./dist && rimraf ./web",
    "dev": "concurrently -k 'npm run dev:node' 'npm run dev:web'",
    "dev:node": "tsc --watch",
    "dev:web": "webpack --mode=development --watch",
    "docs": "npm run generate:docs",
    "format": "prettier --write '{source,test}/**/*.{js,ts}'",
    "generate:docs": "typedoc",
    "generate:vault": "npm run build:node && node scripts/gen_vault_format_a.js && node scripts/gen_vault_format_b.js",
    "prepare": "husky && run-s build",
    "prepublishOnly": "run-s build",
    "test": "run-s test:node test:web test:format",
    "test:format": "prettier --check '{source,test}/**/*.{js,ts}'",
    "test:integration": "npm run build:node && mocha -r test/index.js --timeout 15000 'test/integration/**/*.spec.js'",
    "test:integration:watch": "nodemon --exec 'npm run test:integration' --watch source --watch test",
    "test:coverage": "npm run build:node && c8 mocha -r test/index.js --timeout 60000 'test/{unit,integration}/**/*.spec.js'",
    "test:node": "npm run build:node && mocha -r test/index.js --timeout 15000 'test/{unit,integration}/**/*.spec.js'",
    "test:unit": "npm run build:node && mocha -r test/index.js 'test/unit/**/*.spec.js'",
    "test:unit:watch": "nodemon --exec 'npm run test:unit' --watch source --watch test",
    "test:web": "webpack --config webpack.test.config.cjs && wtr",
    "test:web:production": "BUNDLE=production npm run test:web"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "*.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "{source,test}/**/*.{js,ts}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buttercup/buttercup-core"
  },
  "keywords": [
    "password",
    "vault",
    "credentials",
    "login",
    "secure",
    "buttercup"
  ],
  "author": "Perry Mitchell <perry@perrymitchell.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/buttercup/buttercup-core/issues"
  },
  "homepage": "https://github.com/buttercup/buttercup-core#readme",
  "dependencies": {
    "@buttercup/channel-queue": "^1.4.0",
    "@buttercup/dropbox-client": "git+http://192.168.168.6:3050/buttercup.codekunde/dropbox-client.git#master",
    "@buttercup/googledrive-client": "git+http://192.168.168.6:3050/buttercup.codekunde/googledrive-client.git#master",
    "@buttercup/onedrive-client": "git+http://192.168.168.6:3050/buttercup.codekunde/onedrive-client.git#master",
    "crypto-random-string": "^6.0.0",
    "eventemitter3": "^5.0.0",
    "fast-levenshtein": "^3.0.0",
    "foreachasync": "^5.1.3",
    "form-data": "^4.0.0",
    "fuse.js": "^7.5.0",
    "global": "^4.4.0",
    "hash.js": "^1.1.7",
    "layerr": "^3.0.0",
    "pako": "^3.0.2",
    "path-posix": "^1.0.0",
    "pify": "^6.1.0",
    "url-join": "^5.0.0",
    "uuid": "^14.0.2",
    "webdav": "^5.5.0"
  },
  "overrides": {
    "pbkdf2": "^3.1.6",
    "sha.js": "^2.4.12",
    "min-document": "^2.19.2",
    "webdav": {
      "minimatch": "^10.2.6"
    },
    "@buttercup/fetch": "git+http://192.168.168.6:3050/buttercup.codekunde/fetch.git#main"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-chrome": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "arraybuffer-loader": "^1.0.8",
    "base64-js": "^1.5.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "iocane": "^5.2.0",
    "lint-staged": "^17.5.1",
    "mocha": "^12.0.2",
    "nested-property": "^4.0.0",
    "nodemon": "^3.0.2",
    "npm-run-all": "^4.1.1",
    "null-loader": "^4.0.1",
    "prettier": "^3.1.0",
    "resolve-typescript-plugin": "^2.0.1",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "sleep-promise": "^9.1.0",
    "tmp": "^0.2.1",
    "ts-loader": "^9.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "webdav-server": "^2.6.2",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3"
  }
}
