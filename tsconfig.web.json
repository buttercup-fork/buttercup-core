{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "outDir": "./dist/web",
        "module": "es2020",
        "moduleResolution": "node",
        "declaration": true,
        "target": "es2020",
        "alwaysStrict": true,
        "noImplicitThis": true,
        "strictBindCallApply": true,
        "strictFunctionTypes": true,
        "useUnknownInCatchVariables": true
    },
    "files": [
      "./source/**/*"
    ]
}
